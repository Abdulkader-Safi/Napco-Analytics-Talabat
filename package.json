{
	"name": "napcoanalytics",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "env $(grep -v '^#' .env 2>/dev/null | xargs) drizzle-kit push",
		"db:generate": "env $(grep -v '^#' .env 2>/dev/null | xargs) drizzle-kit generate",
		"db:migrate": "env $(grep -v '^#' .env 2>/dev/null | xargs) drizzle-kit migrate",
		"db:studio": "env $(grep -v '^#' .env 2>/dev/null | xargs) drizzle-kit studio",
		"db:seed": "env $(grep -v '^#' .env 2>/dev/null | xargs) bun run scripts/seed.ts",
		"db:build-forecast": "env $(grep -v '^#' .env 2>/dev/null | xargs) bun run scripts/build-forecast-model.ts",
		"rsync": "rsync -avz --exclude 'node_modules' --exclude '.svelte-kit' --exclude 'build' --exclude '.git' --exclude '.env*' --exclude '*.log' --exclude '.DS_Store' . goai:/var/www/napco-v2",
		"setup": "bun install && env $(grep -v '^#' .env | xargs) bun run build && pm2 restart ecosystem.config.cjs || pm2 start ecosystem.config.cjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^22",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.4",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"formsnap": "^2.0.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"sveltekit-superforms": "^2.28.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@tanstack/table-core": "^8.21.3",
		"better-auth": "^1.4.9",
		"postgres": "^3.4.7",
		"xlsx": "^0.18.5"
	}
}
